# ---------------------------------------------------------------------------
# HUDERA AI platform — configuration. Copy to .env for the Supabase CLI and
# NEVER commit real values. Secrets go to Supabase with:
#   supabase secrets set --env-file backend/.env
# ---------------------------------------------------------------------------

# --- Google sign-in (Supabase → Authentication → Providers → Google) ---------
# From Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
GOOGLE_CLIENT_ID=0000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# --- Edge Function secrets (email-worker, email-webhook, account-delete) -----
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# to Edge Functions automatically by Supabase — do not set them yourself.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be an address on a domain verified in Resend (SPF + DKIM records added).
EMAIL_FROM="HUDERA AI <hello@your-domain.com>"
EMAIL_REPLY_TO=hudera.ai@gmail.com
SITE_URL=https://hudera-ai.github.io
ALLOWED_ORIGINS=https://hudera-ai.github.io
# Long random string; pg_cron sends it in the x-worker-secret header.  openssl rand -hex 32
WORKER_SECRET=change-me-to-a-long-random-string
# Resend → Webhooks → signing secret (starts with whsec_)
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Website + admin dashboard (public values, safe to publish) --------------
# Put these two in portfolio2/src/config.json, then run: python3 portfolio2/build.py
#   "supabaseUrl": "https://<project-ref>.supabase.co"
#   "supabaseAnonKey": "<anon / publishable key>"
